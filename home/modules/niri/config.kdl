environment {
    QT_QPA_PLATFORM "wayland"
}

input {
    keyboard {
        xkb {
            layout "us"
            options "compose:ralt,caps:none"
        }
        repeat-delay 200
        repeat-rate 60
    }

    warp-mouse-to-focus mode="center-xy"
    workspace-auto-back-and-forth
    mod-key "Super"
}

layout {
    always-center-single-column true

    // a border section only counts as enabled when it is in the main file
    border {
        on
    }

    focus-ring {
        off
    }

    shadow {
        on
    }

    tab-indicator {
        hide-when-single-tab
    }
}

// hidden parking spot for toggleable apps, always index 1: workspace binds are offset by one
workspace "scratch"

prefer-no-csd

spawn-at-startup "wayland-pipewire-idle-inhibit"
spawn-at-startup "niri" "msg" "action" "focus-workspace" "2"

hotkey-overlay {
    skip-at-startup
}

window-rule {
    open-maximized false
}

binds {
    // Menu
    Mod+P { spawn "dms" "ipc" "call" "spotlight" "toggle"; }

    // Scratchpad-like apps (focus if open, else launch)
    Mod+C { spawn "niri-scratchpad" "calendar.google.com__calendar" "calendar"; }

    // Previous workspace
    Mod+Tab { focus-workspace-previous; }

    // Terminal
    Mod+Shift+Return { spawn "alacritty"; }

    // Close window / quit
    Mod+Shift+C { close-window; }
    Mod+Shift+Q { quit; }

    // Focus window
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // Move (swap) window/column
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // Resize
    Mod+Ctrl+H { set-column-width "-10%"; }
    Mod+Ctrl+L { set-column-width "+10%"; }
    Mod+Ctrl+J { spawn "niri-resize-v" "down"; }
    Mod+Ctrl+K { spawn "niri-resize-v" "up"; }

    // Layout / floating
    Mod+Space { switch-preset-column-width; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+T { move-window-to-tiling; }
    Mod+Slash { consume-window-into-column; }
    Mod+Shift+Slash { expel-window-from-column; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // niri-only extras
    Mod+F { fullscreen-window; }
    Mod+Shift+F { maximize-window-to-edges; }
    Mod+A { toggle-overview; }

    // Monitors
    Mod+W { focus-monitor-left; }
    Mod+E { focus-monitor-right; }
    Mod+Shift+W { move-column-to-monitor-left; }
    Mod+Shift+E { move-column-to-monitor-right; }

    Mod+1 { focus-workspace 2; }
    Mod+2 { focus-workspace 3; }
    Mod+3 { focus-workspace 4; }
    Mod+4 { focus-workspace 5; }
    Mod+5 { focus-workspace 6; }
    Mod+6 { focus-workspace 7; }
    Mod+7 { focus-workspace 8; }
    Mod+8 { focus-workspace 9; }
    Mod+9 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 2; }
    Mod+Shift+2 { move-column-to-workspace 3; }
    Mod+Shift+3 { move-column-to-workspace 4; }
    Mod+Shift+4 { move-column-to-workspace 5; }
    Mod+Shift+5 { move-column-to-workspace 6; }
    Mod+Shift+6 { move-column-to-workspace 7; }
    Mod+Shift+7 { move-column-to-workspace 8; }
    Mod+Shift+8 { move-column-to-workspace 9; }
    Mod+Shift+9 { move-column-to-workspace 10; }

    // Screenshots
    Print { screenshot; }
    Mod+Shift+S { screenshot; }
    Mod+Ctrl+S { screenshot-screen; }
    Mod+Alt+S { screenshot-window; }

    // Notifications
    Mod+M { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+M { spawn "dms" "ipc" "call" "notifications" "clearAll"; }

    // Clipboard
    Mod+Shift+Y { spawn "dms" "ipc" "call" "clipboard" "toggle"; }

    // Island dashboard
    Mod+D { spawn "dms" "ipc" "call" "island" "toggle" "home"; }
    Mod+Shift+D { spawn "dms" "ipc" "call" "island" "cycle"; }

    // Media
    XF86AudioRaiseVolume { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86AudioLowerVolume { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMute { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    Shift+XF86AudioLowerVolume { spawn "playerctl" "--player" "spotify" "volume" "0.05-"; }
    Shift+XF86AudioRaiseVolume { spawn "playerctl" "--player" "spotify" "volume" "0.05+"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "10%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
}

include optional=true "dms/layout.kdl"
include optional=true "dms/colors.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "dms/windowrules.kdl"
